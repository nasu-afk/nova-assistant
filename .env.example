# Copy this file to `.env` and fill in real values.
# NEVER commit your actual `.env` file.
# All variables are prefixed with NOVA_ (see app/config/settings.py).

# --- Application ---
NOVA_APP_NAME=NOVA
NOVA_ENVIRONMENT=development
NOVA_LOG_LEVEL=INFO
NOVA_LOG_JSON=false
NOVA_DATA_DIR=data

# --- LLM provider ---
# One of: anthropic, groq, openai, local
NOVA_LLM_PROVIDER=groq
NOVA_LLM_MODEL=llama-3.3-70b-versatile
NOVA_LLM_API_KEY=gsk_your_groq_key_here
# For Anthropic instead, use:
#   NOVA_LLM_PROVIDER=anthropic
#   NOVA_LLM_MODEL=claude-sonnet-4-6
#   NOVA_LLM_API_KEY=sk-ant-...

# --- Voice ---
# One of: whisper_local, groq, none
NOVA_VOICE_PROVIDER=groq
NOVA_PUSH_TO_TALK_KEY=ctrl+space
# For --wakeword mode: one of alexa, hey_mycroft, hey_jarvis, hey_rhasspy.
# openwakeword has no "nova" model — say the actual phrase for whichever you pick.
NOVA_WAKE_WORD_MODEL=hey_jarvis
# NOVA_VOICE_PROVIDER=groq reuses NOVA_LLM_API_KEY above (only if NOVA_LLM_PROVIDER=groq;
# otherwise set NOVA_VOICE_API_KEY) for both
# transcription (whisper-large-v3-turbo) and speech (canopylabs/orpheus-v1-english).
# Note: Groq's free tier for TTS specifically is tight (~200 chars/request,
# low daily cap) compared to chat/STT — fine for short replies, not for
# reading long text aloud. See console.groq.com/settings/billing.

# --- Database ---
NOVA_DATABASE_URL=sqlite+aiosqlite:///data/nova.db

# --- Browser ---
NOVA_BROWSER_HEADLESS=true

# --- Security ---
NOVA_REQUIRE_CONFIRMATION_FOR_HIGH_RISK=true
NOVA_REQUIRE_CONFIRMATION_FOR_CRITICAL_RISK=true
NOVA_COMMAND_TIMEOUT_SECONDS=30

# Folder NOVA's file tools may read/write/delete. Empty = your home folder.
# (Credential files like .env, .ssh/, *.pem are always refused, even inside it.)
NOVA_WORKSPACE_ROOT=

# run_command / git / npm / docker tools. Off by default; they're powerful.
NOVA_ENABLE_DEVELOPER_TOOLS=false

# Wake-word mode: minimum loudness (RMS over a 1s chunk) before the wake-word
# model runs. Lower it if "Hey NOVA" is never detected; raise it in noisy rooms.
NOVA_WAKE_VAD_THRESHOLD=200

# Wake phrase model: alexa | hey_mycroft | hey_jarvis | hey_rhasspy, or the path to a
# custom-trained .onnx/.tflite file (e.g. your own "Hey NOVA"; see README, "Wake word").
# NOVA_WAKE_WORD_MODEL=hey_jarvis

# Groq key for voice when your LLM provider is NOT Groq (never reuses an Anthropic key).
# NOVA_VOICE_API_KEY=gsk_...

# Keep every voice recording as data/debug_last_recording.wav (off by default).
NOVA_DEBUG_SAVE_AUDIO=false
